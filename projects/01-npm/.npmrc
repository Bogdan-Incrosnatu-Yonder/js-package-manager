# npm configuration for this project.
# Docs: https://docs.npmjs.com/cli/v10/using-npm/config

# Refuse to install if the local Node version does not satisfy "engines".
engine-strict=true

# Quieter output during the workshop.
fund=false

# Keep the audit step on: it is one of npm's differentiators.
audit=true

# Save exact versions when you `npm install <pkg>` during the exercises,
# so everyone in the room resolves the same tree.
save-exact=false
