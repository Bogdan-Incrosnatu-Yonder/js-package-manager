# pnpm configuration for this project.
# Docs: https://pnpm.io/npmrc

# Angular's CLI resolves a few packages it does not declare. Without this,
# `ng build` can fail with "cannot find module" under pnpm's strict linker.
# Try commenting it out to see pnpm's strictness first-hand.
shamefully-hoist=false

# Fail fast if the local Node version does not satisfy "engines".
engine-strict=true

# Show the content-addressable store location in the install summary.
reporter=default
